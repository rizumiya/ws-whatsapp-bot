PORT=3000
NODE_ENV=development

# Master API Key untuk autentikasi endpoint manajemen (buat sesi, hapus sesi, dll)
MASTER_API_KEY=your_secure_master_api_key

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=whatsapp_bot

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Log Level
LOG_LEVEL=info

# Batas badan permintaan kirim media (base64 ~4/3 ukuran file). Default 25mb = file ~18 MB.
MEDIA_BODY_LIMIT=25mb
